# Copy to .env (or set in your shell / hosting dashboard) to change the defaults.
FLOOD_HOST=127.0.0.1
FLOOD_PORT=8000
# Where GeoTIFF results are written
FLOOD_RESULTS_DIR=./results
# Optional: your own street map tiles (comma-separated URLs) and credit line
# FLOOD_STREET_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# FLOOD_STREET_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
