# Copy to .env (or set in your shell / hosting dashboard) to change the defaults.
FLOOD_HOST=127.0.0.1
FLOOD_PORT=8000
# Where GeoTIFF results are written
FLOOD_RESULTS_DIR=./results
# Optional: your own street map tiles (comma-separated URLs) and credit line
# FLOOD_STREET_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# FLOOD_STREET_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Optional: websites allowed to call the API from the browser (comma-separated), e.g. an Angular frontend
# FLOOD_CORS_ORIGINS=http://localhost:4200,https://your-team.github.io

# Prepared terrain (see docs/prepared-terrain.md)
# FLOOD_TERRAIN=https://<your-bucket-address>/terrain
# FLOOD_LIVE_TERRAIN=0          # only prepared regions (small servers)
# FLOOD_MAX_SIDE_DEG=0.15       # smaller largest-area size for small servers
# FLOOD_TERRAIN_CACHE=1         # keep one area in memory instead of two
# FLOOD_KEEP_RUNS=10            # finished runs kept in memory
